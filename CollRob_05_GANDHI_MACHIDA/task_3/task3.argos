<?xml version="1.0" ?>
<argos-configuration>

  <!--
    Tutorial 5 - Task 3: Foraging.

    Robots (foot-bots running foraging.lua) search the arena for objects
    (movable cylinders carrying a blue LED), push them into the home zone
    marked by a bright yellow light on the west wall, and return.

    run_experiments.py patches the robot quantity, the experiment length and
    the random seed, and strips the visualization block to run headless.
  -->

  <framework>
    <system threads="0" />
    <experiment length="300" ticks_per_second="10" random_seed="124" />
  </framework>

  <controllers>
    <lua_controller id="foraging_controller">
      <actuators>
        <differential_steering implementation="default" />
        <range_and_bearing     implementation="default" />
        <leds                  implementation="default" medium="leds" />
      </actuators>
      <sensors>
        <footbot_proximity implementation="default" show_rays="false" />
        <footbot_light     implementation="rot_z_only" show_rays="false" />
        <colored_blob_omnidirectional_camera implementation="rot_z_only" medium="leds" />
        <range_and_bearing implementation="medium" medium="rab" show_rays="false" />
        <positioning       implementation="default" />
      </sensors>
      <params script="foraging.lua" />
    </lua_controller>
  </controllers>

  <!-- Ground-truth scoring: an object entering the home disc is counted as
       collected and immediately respawned in the foraging field. This keeps
       the resource from depleting and stops delivered objects from piling up
       inside the robots' camera range. -->
  <loop_functions library="libforaging_loop.so" label="foraging_loop"
                  home_x="-1.75" home_y="0" home_radius="0.35"
                  field_min_x="-0.40" field_max_x="1.75"
                  field_min_y="-1.75" field_max_y="1.75" />

  <!-- 4 m x 4 m arena inside a 5 m x 5 m area -->
  <arena size="5, 5, 1" center="0,0,0.5">
    <box id="wall_north" size="4,0.1,0.5" movable="false"><body position="0, 2,0" orientation="0,0,0" /></box>
    <box id="wall_south" size="4,0.1,0.5" movable="false"><body position="0,-2,0" orientation="0,0,0" /></box>
    <box id="wall_east"  size="0.1,4,0.5" movable="false"><body position=" 2,0,0" orientation="0,0,0" /></box>
    <box id="wall_west"  size="0.1,4,0.5" movable="false"><body position="-2,0,0" orientation="0,0,0" /></box>

    <!-- Home zone: a bright light on the west wall. A robot is "home" when the
         sum of its 24 light readings exceeds 3.6 (about 0.65 m from the light). -->
    <light id="home_light" position="-1.75,0,0.4" orientation="0,0,0"
           color="yellow" intensity="3.0" medium="leds" />

    <!-- Objects: movable cylinders with a blue LED, placed away from home so
         that they have to be transported. -->
    <distribute>
      <position    method="uniform" min="-0.4,-1.75,0" max="1.75,1.75,0" />
      <orientation method="constant" values="0,0,0" />
      <entity quantity="40" max_trials="500">
        <cylinder id="obj" radius="0.08" height="0.15" movable="true" mass="0.4">
          <leds medium="leds">
            <led offset="0,0,0.16" anchor="origin" color="blue" />
          </leds>
        </cylinder>
      </entity>
    </distribute>

    <!-- Robots start on the home side of the arena. -->
    <distribute>
      <position    method="uniform"  min="-1.75,-1.75,0" max="-0.9,1.75,0" />
      <orientation method="gaussian" mean="0,0,0" std_dev="360,0,0" />
      <entity quantity="5" max_trials="200">
        <foot-bot id="fb"><controller config="foraging_controller" /></foot-bot>
      </entity>
    </distribute>
  </arena>

  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <media>
    <range_and_bearing id="rab" />
    <led               id="leds" />
  </media>

  <visualization>
    <qt-opengl>
      <camera>
        <placements>
          <placement index="0" position="0,0,6" look_at="0,0,0" up="1,0,0" lens_focal_length="20" />
        </placements>
      </camera>
    </qt-opengl>
  </visualization>

</argos-configuration>
