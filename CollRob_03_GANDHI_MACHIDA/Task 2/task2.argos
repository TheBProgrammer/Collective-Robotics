<?xml version="1.0" ?>
<argos-configuration>

  <!--
    Tutorial 3 - Task 2: Swarm aggregation with anti-agents.
    Two Lua controllers are defined:
      * swarm_controller     -> normal "aggregating" foot-bots (task2.lua)
      * anti_agent_controller -> anti-agents that wander and order robots to leave clusters (anti_agent.lua)
    The number of normal robots and anti-agents is patched at runtime by run_experiments.py.
  -->

  <framework>
    <system threads="0" />
    <experiment length="200" ticks_per_second="10" random_seed="124" />
  </framework>

  <controllers>
    <lua_controller id="swarm_controller">
      <actuators>
        <differential_steering implementation="default" />
        <range_and_bearing    implementation="default" />
        <leds                 implementation="default" medium="leds" />
      </actuators>
      <sensors>
        <footbot_proximity    implementation="default" show_rays="false" />
        <range_and_bearing    implementation="medium"  medium="rab"  show_rays="false" />
        <positioning          implementation="default" />
      </sensors>
      <params script="task2.lua" />
    </lua_controller>

    <lua_controller id="anti_agent_controller">
      <actuators>
        <differential_steering implementation="default" />
        <range_and_bearing    implementation="default" />
        <leds                 implementation="default" medium="leds" />
      </actuators>
      <sensors>
        <footbot_proximity    implementation="default" show_rays="false" />
        <range_and_bearing    implementation="medium"  medium="rab"  show_rays="false" />
        <positioning          implementation="default" />
      </sensors>
      <params script="anti_agent.lua" />
    </lua_controller>
  </controllers>

  <!-- 4 m x 4 m arena inside a 5 m x 5 m area -->
  <arena size="5, 5, 1" center="0,0,0.5">
    <box id="wall_north" size="4,0.1,0.5" movable="false"><body position="0, 2,0" orientation="0,0,0" /></box>
    <box id="wall_south" size="4,0.1,0.5" movable="false"><body position="0,-2,0" orientation="0,0,0" /></box>
    <box id="wall_east"  size="0.1,4,0.5" movable="false"><body position=" 2,0,0" orientation="0,0,0" /></box>
    <box id="wall_west"  size="0.1,4,0.5" movable="false"><body position="-2,0,0" orientation="0,0,0" /></box>

    <!-- Normal robots: id prefix "nb" -->
    <distribute>
      <position    method="uniform"  min="-1.8,-1.8,0" max="1.8,1.8,0" />
      <orientation method="gaussian" mean="0,0,0" std_dev="360,0,0" />
      <entity quantity="30" max_trials="200">
        <foot-bot id="nb"><controller config="swarm_controller" /></foot-bot>
      </entity>
    </distribute>

    <!-- Anti-agents: id prefix "aa" -->
    <distribute>
      <position    method="uniform"  min="-1.8,-1.8,0" max="1.8,1.8,0" />
      <orientation method="gaussian" mean="0,0,0" std_dev="360,0,0" />
      <entity quantity="3" max_trials="200">
        <foot-bot id="aa"><controller config="anti_agent_controller" /></foot-bot>
      </entity>
    </distribute>
  </arena>

  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <media>
    <range_and_bearing id="rab" />
    <led               id="leds" />
  </media>

  <visualization>
    <qt-opengl>
      <camera>
        <placements>
          <placement index="0" position="0,0,6" look_at="0,0,0" up="1,0,0" lens_focal_length="20" />
        </placements>
      </camera>
    </qt-opengl>
  </visualization>

</argos-configuration>
